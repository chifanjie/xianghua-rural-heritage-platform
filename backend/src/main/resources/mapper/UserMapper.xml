<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rrmplatform.mapper.UserMapper">
    <!--通过登录帐号查找用户信息-->
    <select id="queryUser" resultType="com.example.rrmplatform.pojo.User" parameterType="String">
        SELECT *
        FROM user
        WHERE username=#{username}
    </select>
    <!--通过登录帐号查找用户password_hash。不是多此一举，是为了解决mybatis-plus '_' 转 驼峰问题 汗-->
    <select id="queryPassword" resultType="String" parameterType="String">
        SELECT use.password_hash
        FROM user
        WHERE username=#{username}
    </select>

    <!--通过登录帐号查找用户权限信息-->
    <select id="getUserPower" resultType="java.util.HashMap" parameterType="String">
        SELECT user.id ,user.username,role.name as roleName,role.id,permission.name as perName,permission.id
        FROM `user` AS user, role , permission , permission_to_role WHERE user.username=#{userName}
                                                                      AND user.role_id=role.id
                                                                      AND permission_to_role.permission_id=permission.id
                                                                      AND permission_to_role.role_id=role.id
    </select>

    <!--保存用户-->
    <insert id="saveUser" parameterType="com.example.rrmplatform.pojo.User">
        INSERT INTO user(username,password_hash,salt,role_id)
        VALUES( #{username}, #{password_hash}, #{salt}, #{role_id})
    </insert>


</mapper>