<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rrmplatform.mapper.LinkMapper">
    <select id="selectByLId" resultType="com.example.rrmplatform.pojo.Link" parameterType="int">
        SELECT *
        FROM Link
        WHERE LId=#{id}
    </select>
    <select id="selectByGId" resultType="com.example.rrmplatform.pojo.Link" parameterType="int">
        SELECT *
        FROM Link
        WHERE GId=#{gId}
    </select>
</mapper>
